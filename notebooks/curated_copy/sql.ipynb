    "#sql string functions\n",
    "-- =========================\n",
    "-- MySQL STRING essentials (interview quick-ref)\n",
    "-- =========================\n",
    "#Strings in Mysql index starts at 1\n",
    "\n",
    "-- 1) CONCAT / CONCAT_WS  (build strings)\n",
    "SELECT CONCAT('a','-', 'b');                  -- 'a-b'\n",
    "SELECT CONCAT_WS('|', 'a', NULL, 'b');        -- 'a|b' (skips NULLs)\n",
    "\n",
    "-- 2) LOWER / UPPER  (case normalize)\n",
    "SELECT LOWER('AbC'), UPPER('AbC');            -- 'abc', 'ABC'\n",
    "\n",
    "-- 3) TRIM / LTRIM / RTRIM  (whitespace cleanup)\n",
    "SELECT TRIM('  hi  '), LTRIM('  hi'), RTRIM('hi  ');\n",
    "\n",
    "-- 4) REPLACE  (literal replace)\n",
    "SELECT REPLACE('a-b-c', '-', '_');            -- 'a_b_c'\n",
    "\n",
    "-- 5) LENGTH vs CHAR_LENGTH  (bytes vs characters)\n",
    "SELECT LENGTH('á'), CHAR_LENGTH('á');         -- depends on charset; CHAR_LENGTH is safer for \"characters\"\n",
    "\n",
    "-- 6) SUBSTRING / LEFT / RIGHT  (slicing)\n",
    "SELECT SUBSTRING('abcdef', 2, 3);             -- 'bcd'  (1-indexed)\n",
    "SELECT LEFT('abcdef', 2), RIGHT('abcdef', 2); -- 'ab', 'ef'\n",
    "\n",
    "-- 7) INSTR / LOCATE  (find position of substring)\n",
    "SELECT INSTR('hello world', 'world');         -- 7 (1-indexed)\n",
    "SELECT LOCATE('world', 'hello world');        -- 7\n",
    "SELECT LOCATE('l', 'hello', 3);               -- start search at pos=3\n",
    "\n",
    "-- 8) LIKE / NOT LIKE  (pattern matching; % and _)\n",
    "-- WHERE name LIKE 'ab%'      -- starts with 'ab'\n",
    "-- WHERE name LIKE '%mid%'    -- contains 'mid'\n",
    "-- WHERE name LIKE 'a_b%'     -- 'a' + any 1 char + 'b...'\n",
    "\n",
    "-- 9) REGEXP_LIKE / REGEXP_REPLACE / REGEXP_SUBSTR (MySQL 8+)\n",
    "-- Exact availability varies by version; commonly used in interviews.\n",
    "SELECT REGEXP_LIKE('abc123', '^[a-z]+[0-9]+$');       -- 1\n",
    "SELECT REGEXP_REPLACE('a   b', '\\\\s+', ' ');          -- 'a b'\n",
    "SELECT REGEXP_SUBSTR('order: 12345', '[0-9]+');       -- '12345'\n",
    "\n",
    "-- 10) SUBSTRING_INDEX  (split by delimiter; very interview-useful)\n",
    "SELECT SUBSTRING_INDEX('a,b,c', ',', 1);      -- 'a'   (first token)\n",
    "SELECT SUBSTRING_INDEX('a,b,c', ',', -1);     -- 'c'   (last token)\n",
    "-- \"first name\" / \"last name\" splits\n",
    "SELECT SUBSTRING_INDEX('john doe', ' ', 1) AS first,\n",
    "       SUBSTRING_INDEX('john doe', ' ', -1) AS last;\n",
    "\n",
    "-- 11) LPAD / RPAD  (padding)\n",
    "SELECT LPAD('7', 3, '0'), RPAD('7', 3, '0');  -- '007', '700'\n",
    "\n",
    "-- 12) IFNULL / COALESCE  (null handling)\n",
    "SELECT IFNULL(NULL, 'x'), COALESCE(NULL, NULL, 'x'); -- 'x', 'x'\n",
    "\n",
    "-- 13) CAST / CONVERT  (type conversions)\n",
    "SELECT CAST('123' AS UNSIGNED), CAST(12.7 AS DECIMAL(10,2)); -- 123, 12.70\n",
    "\n",
    "-- 14) GROUP_CONCAT  (string aggregation; often asked)\n",
    "-- List items per group (beware length limits)\n",
    "-- SELECT user_id, GROUP_CONCAT(item ORDER BY item SEPARATOR ',') AS items\n",
    "-- FROM t GROUP BY user_id;\n",
    "\n"
   ]
