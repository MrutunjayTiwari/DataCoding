   "cell_type": "raw",
   "id": "8d37c82f-5459-42d8-b855-9d632ee8073d",
   "metadata": {},
   "source": [
    "# CTE\n",
    "WITH TotalSales AS (\n",
    "    SELECT SalesPersonID, SUM(TotalDue) AS TotalAmount\n",
    "    FROM SalesOrders\n",
    "    GROUP BY SalesPersonID\n",
    "),\n",
    "HighPerformers AS (\n",
    "    SELECT SalesPersonID\n",
    "    FROM TotalSales\n",
    "    WHERE TotalAmount > 100000\n",
    ")\n",
    "SELECT E.Name, S.TotalAmount\n",
    "FROM Employees E\n",
    "JOIN HighPerformers HP ON E.ID = HP.SalesPersonID\n",
    "JOIN TotalSales S ON E.ID = S.SalesPersonID;"
   ]
  },
