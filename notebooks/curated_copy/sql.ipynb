   "metadata": {},
   "source": [
    "# union and union all\n",
    "SELECT name FROM Employees\n",
    "UNION\n",
    "SELECT name FROM Customers;\n",
    "\n",
    "union - removes duplicates and sorts implicitely\n",
    "union all - does not remove duplicates neither sorts\n",
    "\n",
    "requirement\n",
    "Same Number of Columns: Each SELECT statement must return the same number of columns.\n",
    "Compatible Data Types: The corresponding columns in each SELECT statement must have compatible data types (e.g., CHAR and VARCHAR are compatible).\n",
    "Same Order: The columns must be in the same order in all SELECT statements. \n",
    "\n",
    "\n",
    "\n",
    "#Case When\n",
    "\n",
    "SELECT\n",
    "    customer_name,\n",
    "    COUNT(*) AS orders_count,\n",
    "    CASE\n",
    "        WHEN COUNT(*) > 20 THEN 'VIP'\n",
    "        WHEN COUNT(*) BETWEEN 10 AND 20 THEN 'Regular'\n",
    "        ELSE 'New'\n",
    "    END AS customer_tier"
   ]
  },
