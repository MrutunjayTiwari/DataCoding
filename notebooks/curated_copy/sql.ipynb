    "#Sql date funnction\n",
    "-- MySQL DATE/TIME cheat-sheet (interview-ready)\n",
    "-- keep literals in ISO format ('YYYY-MM-DD' or 'YYYY-MM-DD HH:MM:SS') to avoid parsing surprises.\n",
    "-- When comparing DATE and DATETIME, MySQL typically coerces the DATE to a DATETIME by adding '00:00:00'.\n",
    "\n",
    "Below Example if dt_col is datetime, below statement is valid and common\n",
    "WHERE dt_col >= '2026-01-01' AND dt_col < '2026-02-01'\n",
    "\n",
    "\n",
    "Interview rule of thumb\n",
    "For “within last X”: ts >= NOW() - INTERVAL X UNIT\n",
    "For “ts1 is X after ts2”: ts1 >= ts2 + INTERVAL X UNIT eg ts >= NOW() - INTERVAL 90 MINUTE/DAY/HOUR\n",
    "For “give me the gap”: TIMESTAMPDIFF(unit, ts2, ts1) eg TIMESTAMPDIFF(SECOND, '2026-01-26 10:00:00', NOW()) AS diff_sec\n",
    "Avoid raw ts1 - ts2 unless you explicitly want numeric weirdness.\n",
    "\n",
    "-- Assumes MySQL 8.x.\n",
    "\n",
    "-- ============================================================\n",
    "-- 0) NOW / DATE / UTC\n",
    "-- ============================================================\n",
    "SELECT\n",
    "  NOW()           AS now_local_dt,      -- DATETIME in session time zone\n",
    "  CURDATE()       AS today_date,        -- DATE\n",
    "  UTC_TIMESTAMP() AS now_utc_dt;        -- UTC datetime\n",
    "\n",
    "-- ============================================================\n",
    "-- 1) Convert / parse / format\n",
    "-- ============================================================\n",
    "-- DATETIME/TIMESTAMP -> DATE (drops time)\n",
    "SELECT DATE(NOW()) AS date_only;\n",
    "\n",
    "-- String -> DATETIME\n",
    "SELECT STR_TO_DATE('2026-01-26 14:30:05', '%Y-%m-%d %H:%i:%s') AS parsed_dt;\n",
    "\n",
    "-- DATETIME -> String (display / labels)\n",
    "SELECT DATE_FORMAT(NOW(), '%Y-%m-%d %H:%i:%s') AS fmt_dt;\n",
    "\n",
    "-- ============================================================\n",
    "-- 2) Extract parts (like pandas .dt)\n",
    "-- ============================================================\n",
    "SELECT\n",
    "  YEAR(NOW())      AS yr,\n",
    "  MONTH(NOW())     AS mon,\n",
    "  DAY(NOW())       AS day,\n",
    "  HOUR(NOW())      AS hr,\n",
    "  MINUTE(NOW())    AS min,\n",
    "  SECOND(NOW())    AS sec,\n",
    "  WEEKDAY(NOW())   AS dow_mon0,   -- 0=Mon..6=Sun\n",
    "  DAYOFWEEK(NOW()) AS dow_sun1,   -- 1=Sun..7=Sat\n",
    "  QUARTER(NOW())   AS qtr;\n",
    "\n",
    "-- ============================================================\n",
    "-- 3) Add/Subtract intervals (the \"standard\" pattern)\n",
    "-- ============================================================\n",
    "-- ts1 - ts2 > INTERVAL x UNIT  (MySQL syntax uses DATE_ADD/DATE_SUB equivalently)\n",
    "-- Prefer these for filters because they are index-friendly:\n",
    "--   ts >= NOW() - INTERVAL 7 DAY\n",
    "\n",
    "-- Examples:\n",
    "SELECT\n",
    "  NOW() - INTERVAL 7 DAY   AS minus_7d,\n",
    "  NOW() + INTERVAL 90 MINUTE AS plus_90m,\n",
    "  NOW() - INTERVAL 3 HOUR  AS minus_3h,\n",
    "  NOW() + INTERVAL 1 MONTH AS plus_1m;\n",
    "\n",
    "-- ============================================================\n",
    "-- 4) Filtering (SARGABLE / index-friendly)\n",
    "-- ============================================================\n",
    "-- Last 7 days from now\n",
    "-- WHERE ts >= NOW() - INTERVAL 7 DAY\n",
    "\n",
    "-- Last 90 minutes\n",
    "-- WHERE ts >= NOW() - INTERVAL 90 MINUTE\n",
    "\n",
    "-- Calendar month (half-open interval avoids boundary bugs)\n",
    "-- WHERE ts >= '2026-01-01' AND ts < '2026-02-01'\n",
    "\n",
    "-- Today (local session day)\n",
    "-- WHERE ts >= CURDATE() AND ts < CURDATE() + INTERVAL 1 DAY\n",
    "\n",
    "-- ============================================================\n",
    "-- 5) Timestamp differences (numeric) when you need a number\n",
    "-- ============================================================\n",
    "-- Whole days\n",
    "SELECT DATEDIFF('2026-02-01', '2026-01-26') AS diff_days;\n",
    "\n",
    "-- Precise units\n",
    "SELECT\n",
    "  TIMESTAMPDIFF(SECOND, '2026-01-26 10:00:00', NOW()) AS diff_sec,\n",
    "  TIMESTAMPDIFF(MINUTE, '2026-01-26 10:00:00', NOW()) AS diff_min,\n",
    "  TIMESTAMPDIFF(HOUR,   '2026-01-26 10:00:00', NOW()) AS diff_hr;\n",
    "\n",
    "-- ============================================================\n",
    "-- 6) Bucketing (\"floor\" equivalents)\n",
    "-- ============================================================\n",
    "-- Hour bucket: 10:37:45 -> 10:00:00\n",
    "SELECT DATE_FORMAT(NOW(), '%Y-%m-%d %H:00:00') AS hour_bucket;\n",
    "\n",
    "-- Day bucket: midnight\n",
    "SELECT DATE(NOW()) AS day_bucket;\n",
    "\n",
    "-- Month bucket: first day of month\n",
    "SELECT DATE_FORMAT(NOW(), '%Y-%m-01') AS month_bucket;\n",
    "\n",
    "-- Week bucket (Monday start): subtract weekday offset\n",
    "SELECT DATE_SUB(DATE(NOW()), INTERVAL WEEKDAY(NOW()) DAY) AS week_monday_bucket;\n",
    "\n",
    "-- ============================================================\n",
    "-- 7) Window functions on event streams (MySQL 8+)\n",
    "-- ============================================================\n",
    "-- LAG/LEAD + gap seconds per user\n",
    "-- SELECT\n",
    "--   user_id, ts, revenue,\n",
    "--   LAG(ts) OVER (PARTITION BY user_id ORDER BY ts) AS prev_ts,\n",
    "--   TIMESTAMPDIFF(SECOND,\n",
    "--     LAG(ts) OVER (PARTITION BY user_id ORDER BY ts),\n",
    "--     ts\n",
    "--   ) AS gap_sec\n",
    "-- FROM events;\n",
    "\n",
    "-- Top-N per user by revenue\n",
    "-- WITH ranked AS (\n",
    "--   SELECT *,\n",
    "--          ROW_NUMBER() OVER (PARTITION BY user_id ORDER BY revenue DESC) AS rn\n",
    "--   FROM events\n",
    "-- )\n",
    "-- SELECT * FROM ranked WHERE rn <= 3;\n",
    "\n",
    "-- ============================================================\n",
    "-- 8) Time zone gotcha (TIMESTAMP vs DATETIME)\n",
    "-- ============================================================\n",
    "-- TIMESTAMP is stored in UTC internally and converted using session time zone.\n",
    "-- DATETIME is \"as typed\" (no tz conversion).\n",
    "-- If interviews mention tz, be explicit about using UTC_TIMESTAMP() or session settings.\n",
    "\n",
    "-- ============================================================\n",
    "-- 9) Practical rules of thumb\n",
    "-- ============================================================\n",
    "-- * Prefer: ts >= NOW() - INTERVAL x UNIT  over TIMESTAMPDIFF in WHERE (indexes).\n",
    "-- * Prefer half-open ranges for dates: [start, end) using >= and <.\n",
    "-- * Use DATE(ts) when you truly want DATE type; DATE_FORMAT when you want strings.\n"
   ]
